	<appender name="FILE-SPECIFIC" class="ch.qos.logback.classic.sift.SiftingAppender">
		<discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
			<key>logType</key>
			<defaultValue>null</defaultValue> <!-- Prevent fallback appender creation -->
		</discriminator>

		<sift>
			<appender name="FILE-${logType}" class="ch.qos.logback.core.FileAppender">
				<filter class="ch.qos.logback.classic.filter.EvaluatorFilter">
					<evaluator class="ch.qos.logback.classic.boolex.JaninoEventEvaluator">
<!--						<expression>mdc['logType'] == 'perf'</expression>-->
						<expression>
							System.out.println("MDC: "+mdc);
							return false;
						</expression>
					</evaluator>
					<OnMismatch>DENY</OnMismatch>
					<OnMatch>NEUTRAL</OnMatch>
				</filter>
				<file>/tmp/logs/${logType}.log</file>
				<append>true</append>
				<encoder>
					<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
				</encoder>
			</appender>
		</sift>
	</appender>

	<appender name="STDOUT3" class="ch.qos.logback.core.ConsoleAppender">
		<filter class="com.javatechie.spring.logging.api.MarkerFilter" />
		<layout class="ch.qos.logback.classic.PatternLayout">
			<Pattern>
				%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n
			</Pattern>
		</layout>
	</appender>

	<appender name="FILE-PERF" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>/tmp/logs/perf.log</file>
		<filter class="com.javatechie.spring.logging.api.MarkerFilter" />
		<layout class="ch.qos.logback.classic.PatternLayout">
			<Pattern>
				%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n
			</Pattern>
		</layout>

		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<!-- rollover daily -->
			<fileNamePattern>/tmp/logs/perf.%d{yyyy-MM-dd}.%i.log
			</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy
					class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>10MB</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
	</appender>

